{
  "mcpServers": {
    "docker": {
      "command": "C:\\Program Files\\Docker\\cli-plugins\\docker-mcp.exe",
      "args": ["gateway", "run"]
    },
    "3d-printer": {
      "command": "python",
      "args": ["C:\\Users\\<username>\\Documents\\GitHub\\bambu-mcp-server\\bambu_lab_mcp.py"],
      "env": {
        "BAMBU_PRINTER_IP": "<printer-local-ip>",
        "BAMBU_ACCESS_CODE": "<lan-access-code-from-printer-settings>",
        "BAMBU_SERIAL_NUMBER": "<serial-from-bambu-studio>"
      }
    }
  }
}
